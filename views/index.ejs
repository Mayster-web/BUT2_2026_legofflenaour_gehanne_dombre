<%- include('partials/header') %>

    <%- include('partials/nav') %>

        <img class="accueil" src="./img/accueil.png" alt="Image d'accueil Locfit" />
        <div class="home-undercard">
            <h1>Explorez notre sélection</h1>
            <a class="home-button" href="#">Voir plus</a>
        </div>

        <div class="cards">

            <% for(let id in produit){ %>
                <% let produits=produit[id]; %>
                    <article class="card">
                        <img src="./img/<%= produits.image %>" alt="<%= produits.type %>" />
                        <h3>
                            <%= produits.type %>
                        </h3>
                        <div class="content">
                            <p><strong>
                                    <%= produits.marque %>
                                        <%= produits.modele %>
                                </strong></p>
                            <p>
                                <%= produits.description %>
                            </p>
                            <p><strong>Prix :</strong>
                                <%= produits.prix_location %> €/jour
                            </p>
                        </div>
                        <a href="/login" class="resa-button">Réserver maintenant</a>
                    </article>
                    <% ;} %>
        </div>

        <%- include('partials/footer') %>