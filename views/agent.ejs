<%- include('partials/header') %>

<%- include('partials/nav') %>

<div class="manager-page">
    <h1>Gestion des produits</h1>

    <% if (erreur) { %>
        <p class="manager-error" role="alert"><%= erreur %></p>
    <% } %>

    <section class="manager-section" aria-labelledby="products-heading">
        <h2 id="products-heading">Tous les produits</h2>
        <% if (produits.length === 0) { %>
            <p>Aucun produit n'est enregistré.</p>
        <% } else { %>
            <div class="manager-table-wrapper">
                <table class="manager-table">
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Type</th>
                            <th scope="col">Marque</th>
                            <th scope="col">Modèle</th>
                            <th scope="col">Prix / jour</th>
                            <th scope="col">État</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (const produit of produits) { %>
                            <tr>
                                <td><%= produit.id %></td>
                                <td><%= produit.type %></td>
                                <td><%= produit.marque %></td>
                                <td><%= produit.modele %></td>
                                <td><%= produit.prix_location %> €</td>
                                <td><%= produit.etat %></td>
                                <td>
                                    <form method="POST" action="/agent/produits/<%= produit.id %>/supprimer">
                                        <button class="manager-delete" type="submit"
                                            aria-label="Supprimer <%= produit.marque %> <%= produit.modele %>">
                                            Supprimer
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>

    <section class="manager-section" aria-labelledby="add-product-heading">
        <h2 id="add-product-heading">Ajouter un produit</h2>
        <form class="manager-form" method="POST" action="/agent/produits">
            <label>
                Type *
                <input type="text" name="type" required>
            </label>
            <label>
                Marque *
                <input type="text" name="marque" required>
            </label>
            <label>
                Modèle *
                <input type="text" name="modele" required>
            </label>
            <label>
                Prix de location par jour (€) *
                <input type="number" name="prix_location" min="0" step="0.01" required>
            </label>
            <label>
                État *
                <input type="text" name="etat" required>
            </label>
            <label>
                Nom du fichier image
                <input type="text" name="image" placeholder="exemple.jpg">
            </label>
            <label class="manager-description">
                Description
                <textarea name="description" rows="4"></textarea>
            </label>
            <button class="manager-submit" type="submit">Ajouter le produit</button>
        </form>
    </section>
</div>

<%- include('partials/footer') %>
