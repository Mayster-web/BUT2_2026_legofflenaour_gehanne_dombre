<%- include('partials/header') %>

    <%- include('partials/nav') %>

        <main>
            <div class="accueil-title">
                <h1>Explorez notre sélection</h1>
                <a href="#">Voir plus</a>
            </div>

            <div class="cards">

            <% produits.forEach(produit => { %>
                <article class="card">
                    <img src="<%= produit.imageUrl %>" alt="<%= produit.type %>" />
                    <h3><%= produit.type %></h3>
                    <div class="content">
                        <p><strong><%= produit.marque %> <%= produit.modele %></strong></p>
                        <p><%= produit.description %></p>
                        <p><strong>Prix :</strong> <%= produit.prix_location %> €/jour</p>
                    </div>
                    <a href="/login" class="resa-button">Réserver maintenant</a>
                </article>
            <% }); %>
            </div>

        </main>

        <%- include('partials/footer') %>