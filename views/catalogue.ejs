<%- include('partials/header') %>

    <%- include('partials/nav') %>

        <main>
            <div class="accueil-title">
                <h1>Explorez notre sélection</h1>
                <a href="#">Voir plus</a>
            </div>

            <div class="cards">

            <% for(let id in produit){ %>
                <% let produits = produit[id]; %>
                <article class="card">
                    <img src="./img/<%= produits.image %>" alt="<%= produits.type %>" />
                    <h3><%= produits.type %></h3>
                    <div class="content">
                        <p><strong><%= produits.marque %> - <%= produits.modele %></strong></p>
                        <p class="description-tronquer"><%= produits.description %></p>
                        <a href="/" class="card-plus">Voir plus →</a>
                        
                        <p class="prix"><strong>Prix :</strong> <%= produits.prix_location %> €/jour</p>
                    </div>
                    <a href="/login" class="resa-button">Réserver maintenant</a>
                </article>
            <% ;} %>
            </div>

        </main>

        <%- include('partials/footer') %>