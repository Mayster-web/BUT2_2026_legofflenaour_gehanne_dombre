<%- include('partials/header') %>

<%- include('partials/nav') %>

<section class="login-page" aria-labelledby="login-title">
    <div class="login-card">
        <h1 id="login-title">Se connecter</h1>

        <form class="login-form">
            <div class="login-field">
                <label for="login-email">Adresse e-mail</label>
                <input id="login-email" name="email" type="email" autocomplete="email" placeholder="exemple@email.com" required>
            </div>

            <div class="login-field">
                <label for="login-password">Mot de passe</label>
                <input id="login-password" name="password" type="password" autocomplete="current-password" placeholder="Votre mot de passe" required>
            </div>
            <a class="forget-mdp"href="#">Mot de passe oublié ?</a>

            <button class="login-submit" type="button" disabled>Confirmer</button>
        </form>

    </div>
</section>

<%- include('partials/footer') %>