<%- include('partials/header') %>

<%- include('partials/nav') %>

<section class="login-page" aria-labelledby="signup-title">
    <div class="login-card">
        <div class="account-heading">
            <a class="account-switch-link" href="/login">Se connecter</a>
            <h1 id="signup-title">S'inscrire</h1>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <p role="alert"><%= error %></p>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <p role="status"><%= success %></p>
        <% } %>

        <form class="login-form" method="POST" action="/inscription">
            <div class="login-field">
                <label for="signup-login">Nom d'utilisateur</label>
                <input id="signup-login" name="login" type="text" autocomplete="username" placeholder="Choisissez un identifiant" required>
            </div>

            <div class="login-field">
                <label for="signup-prenom">Prénom</label>
                <input id="signup-prenom" name="prenom" type="text" autocomplete="given-name" placeholder="Votre prénom" required>
            </div>

            <div class="login-field">
                <label for="signup-nom">Nom</label>
                <input id="signup-nom" name="nom" type="text" autocomplete="family-name" placeholder="Votre nom" required>
            </div>

            <div class="login-field">
                <label for="signup-ddn">Date de naissance</label>
                <input id="signup-ddn" name="ddn" type="date" autocomplete="bday" required>
            </div>

            <div class="login-field">
                <label for="signup-email">Adresse e-mail</label>
                <input id="signup-email" name="email" type="email" autocomplete="email" placeholder="exemple@email.com" required>
            </div>

            <div class="login-field">
                <label for="signup-password">Mot de passe</label>
                <input id="signup-password" name="password" type="password" autocomplete="new-password" placeholder="Choisissez un mot de passe" required>
            </div>

            <div class="login-field">
                <label for="signup-password-confirm">Confirmer le mot de passe</label>
                <input id="signup-password-confirm" name="password-confirm" type="password" autocomplete="new-password" placeholder="Répétez votre mot de passe" required>
            </div>

            <button class="login-submit" type="submit">Confirmer</button>
        </form>

        <div class="social-login" aria-label="Inscription avec un compte social">
            <p class="social-login-divider"><span>ou continuer avec</span></p>
            <div class="social-login-options">
                <button class="social-login-button social-apple" type="button" aria-label="Inscription avec Apple" disabled>
                    <i class="fa-brands fa-apple" aria-hidden="true"></i>
                    Apple
                </button>
                <button class="social-login-button social-google" type="button" aria-label="Inscription avec Google" disabled>
                    <i class="fa-brands fa-google" aria-hidden="true"></i>
                    Google
                </button>
                <button class="social-login-button social-facebook" type="button" aria-label="Inscription avec Facebook" disabled>
                    <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
                    Facebook
                </button>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
